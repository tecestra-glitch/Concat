# Fronteira FX — frontend Next.js (saída standalone) para o perfil `web` do docker-compose.
#
# Requer `output: "standalone"` em next.config.ts (sem isso não existe .next/standalone e o estágio
# final falha). Segredos (FX_API_KEY) entram só em tempo de execução, por variável de ambiente, e são
# lidos pelo proxy server-side em src/app/api/fx. Nada com NEXT_PUBLIC_ é segredo: vai para o navegador.
# Base pinada por digest; para atualizar: docker buildx imagetools inspect docker.io/library/node:<tag>
FROM node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS base
ENV NEXT_TELEMETRY_DISABLED=1
# Mesma versão do campo `packageManager` do package.json.
RUN npm install -g pnpm@10.28.0
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# --ignore-scripts: o `prepare` do package.json instala hooks do husky no repositório Git, que não existe na imagem.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts --store-dir /pnpm/store

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Sem .env na imagem (ver .dockerignore): nada de ambiente é embutido no bundle.
RUN pnpm build

FROM node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS runner
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
WORKDIR /app
RUN groupadd --system nextjs \
    && useradd --system --gid nextjs --home-dir /app --shell /usr/sbin/nologin nextjs
COPY --from=build --chown=nextjs:nextjs /app/.next/standalone ./
COPY --from=build --chown=nextjs:nextjs /app/.next/static ./.next/static
# Se um dia existir `public/`, copie-o também: COPY --from=build /app/public ./public
USER nextjs

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["node", "-e", "fetch('http://127.0.0.1:3000/').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]
CMD ["node", "server.js"]
