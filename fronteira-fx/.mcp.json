{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.4.4"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--headless"
      ]
    },
    "firecrawl": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp@3.36.0"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "api-anything": {
      "command": "node",
      "args": [
        "dev/external/api-anything/dist/cli.js",
        "mcp"
      ],
      "env": {
        "API_ANYTHING_HOME": ".local/api-anything"
      }
    },
    "fronteira-fx": {
      "type": "http",
      "url": "${FX_API_URL:-http://localhost:8000}/mcp",
      "headers": {
        "X-API-Key": "${FX_API_KEY:-}"
      }
    },
    "frankfurter": {
      "type": "http",
      "url": "https://mcp.frankfurter.dev/"
    }
  }
}
