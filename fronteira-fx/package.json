{
  "name": "fronteira-fx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src e2e",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:e2e",
    "prepare": "cd .. && husky fronteira-fx/.husky",
    "deploy": "vercel deploy --yes",
    "deploy:prod": "vercel deploy --prod --yes",
    "test:hooks": "python3 -I .husky/tests/test_hooks.py"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": "eslint",
    "e2e/**/*.ts": "eslint",
    "backend/**/*.py": "uv run --project backend ruff check"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lightweight-charts": "5.2.1",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vercel": "65.9.0",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  }
}
