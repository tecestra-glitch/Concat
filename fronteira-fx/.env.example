# Fronteira FX — modelo de variáveis de ambiente. Copie para `.env` nesta pasta e preencha:
#   cp .env.example .env
# `.env` é ignorado pelo Git; só este modelo é versionado. Nunca escreva valores reais aqui.
# Quem lê o `.env` desta pasta: `docker compose` e o Next.js (`pnpm dev`/`pnpm build`; variáveis sem o
# prefixo NEXT_PUBLIC_ ficam só no servidor). O backend executado fora do compose lê `backend/.env`.
# Comentários só em linhas próprias: parsers de dotenv divergem sobre comentários no fim da linha.

# ─── Obrigatórias para `docker compose up` ───────────────────────────────────────────────────
# Senha do Postgres. Gere uma forte só com [a-f0-9], para não quebrar a URL de conexão:
#   openssl rand -hex 32
# O compose recusa subir se estiver vazia ou ausente, e a api/worker recusam arrancar com os
# placeholders TROQUE_* deste modelo (eles só existem para `docker compose config` validar).
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
# Chave que protege /mcp e as rotas de escrita da API (header X-API-Key ou Bearer). Gere com
# `openssl rand -hex 32`. O navegador nunca a recebe: o proxy server-side do frontend a injeta.
API_KEY=TROQUE_ESTA_CHAVE

# ─── Compose: Postgres e portas publicadas no host (opcionais) ──────────────────────────────
POSTGRES_USER=fx
POSTGRES_DB=fx
# Porta do Postgres no host (sempre em 127.0.0.1).
POSTGRES_PORT=5432
# A API é publicada em API_BIND:API_PORT. Padrão: só loopback; um proxy TLS no host expõe para fora.
API_BIND=127.0.0.1
API_PORT=8000
# Proxy reverso TLS no host (Caddy, nginx, Traefik): ele chega ao container pelo gateway da bridge do
# Docker (ex.: 172.18.0.1; veja `docker network inspect fronteira-fx_default`), nunca por 127.0.0.1.
# Para o uvicorn honrar X-Forwarded-*, defina esse IP (ou `*`, aceitável só enquanto API_BIND ficar em loopback).
# FORWARDED_ALLOW_IPS=127.0.0.1
# Frontend do perfil `web` (docker compose --profile web up -d --build).
WEB_BIND=127.0.0.1
WEB_PORT=3000

# ─── Backend (api e worker) ─────────────────────────────────────────────────────────────────
# Modo de dados servido por esta instância: real | simulation | demo. Os modos nunca se misturam.
DATA_MODE=real
# 1 = semeia dados de demonstração no arranque (só faz sentido com DATA_MODE=demo).
FX_SEED_DEMO=0
# Origens permitidas no CORS (separadas por vírgula). Com o proxy server-side do frontend basta o host local.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Pasta das evidências dos adaptadores (screenshots/HTML). No compose é /app/var/evidence (volume `evidence`).
# `FX_EVIDENCE_DIR` é alias legado da mesma configuração.
EVIDENCE_DIR=./var/evidence
# Base de conhecimento do RAG (backend/knowledge/*.md), semeada no arranque da api; false desliga o seed
# (à mão: `python -m fronteira_fx.cli seed-knowledge`). KNOWLEDGE_DIR vazio = backend/knowledge (no compose, /app/knowledge).
SEED_KNOWLEDGE=true
# KNOWLEDGE_DIR=./knowledge
# Coletor: intervalo base, tique do worker, recuo máximo após erro e janela da "última cotação por contexto".
POLL_INTERVAL_S=300
WORKER_TICK_S=30
BACKOFF_MAX_S=3600
QUOTES_LOOKBACK_S=604800
# Sondagem adaptativa por fonte: piso de 60 s (nunca martelar) e teto.
WATCH_MIN_INTERVAL_S=60
WATCH_MAX_INTERVAL_S=900
# Stream SSE (/v1/stream) e retenção de eventos.
EVENT_RETENTION=20000
EVENT_RETENTION_S=86400
STREAM_MAX_DURATION_S=55
# Modo serverless (API na Vercel + coleta disparada pelo Supabase). Ver docs/deploy.md, "Modo grátis".
# FX_SERVERLESS=1 troca o pool por NullPool e desliga prepared statements (pooler em modo transação).
FX_SERVERLESS=0
# Bearer de POST /v1/internal/collect. Vazio = a rota responde 404. Gere com `openssl rand -hex 32`.
CRON_SECRET=
# `retry:` do SSE, em ms (1000 aqui; 30000 no modo serverless: o cliente reconecta a cada 30 s).
STREAM_RETRY_MS=1000
# Tempo máximo, em s, para iniciar fontes numa rodada de coleta disparada de fora.
COLLECT_BUDGET_S=45
STREAM_HEARTBEAT_S=15
STREAM_POLL_S=1
STREAM_BATCH=500
HISTORY_DEFAULT_GRID_S=300
# Só fora do compose (ex.: `uv run uvicorn` contra o Postgres do compose). Dentro do compose a URL é
# montada a partir de POSTGRES_*. Em dev com SQLite: sqlite:///./var/fx.db
# DATABASE_URL=postgresql+psycopg://fx:TROQUE_ESTA_SENHA@localhost:5432/fx
# No compose o esquema é gerido pelo alembic (false). Fora dele, true cria as tabelas no arranque (SQLite).
# AUTO_CREATE_SCHEMA=true
# Versão exibida em /v1/health; normalmente vem do código e não é repassada pelo compose.
# APP_VERSION=0.1.0

# ─── Notificações (opcionais; vazio = canal desligado; só no backend) ───────────────────────
TELEGRAM_BOT_TOKEN=
# SMTP para alertas por e-mail. SMTP_HOST vazio desliga o canal. Porta e STARTTLS sempre com valor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
ALERT_HTTP_TIMEOUT_S=10

# ─── Frontend: proxy server-side para a API ────────────────────────────────────────────────
# O navegador só fala com /api/fx/*, servido pelo próprio Next.js, que repassa à API com X-API-Key.
# Em `pnpm dev` aponte para a API local. No compose o serviço `web` usa http://api:8000 (fixo).
# Na Vercel defina a URL pública (HTTPS) da API. Nunca use NEXT_PUBLIC_ para isto.
FX_API_URL=http://localhost:8000
# Chave enviada pelo proxy: a mesma API_KEY do backend. Vazia no compose = reutiliza API_KEY.
# Em `pnpm dev` e na Vercel precisa estar preenchida sempre que a API tiver API_KEY.
FX_API_KEY=
# Quem alcança o frontend herda a chave acima. Por isso o proxy só a injeta com o frontend protegido:
#   FX_BASIC_AUTH=usuario:senha  → todo o app pede Basic Auth (src/proxy.ts); use uma senha forte e HTTPS.
#   FX_FRONTEND_PROTECTED=1      → você garante que o frontend já é privado (só loopback, VPN, Vercel
#                                  Deployment Protection). O compose usa 1 enquanto WEB_BIND for 127.0.0.1.
# Sem nenhum dos dois, leituras seguem sem chave e mutações são recusadas pelo proxy (403).
FX_BASIC_AUTH=
FX_FRONTEND_PROTECTED=
# Deixe vazia (padrão): o navegador fala só com o proxy /api/fx. Só para dev local sem chave, com o
# navegador chamando a API diretamente. Nunca recebe segredo: tudo com NEXT_PUBLIC_ vai para o bundle.
NEXT_PUBLIC_API_URL=
