# Backend rodado fora do compose (`uv run uvicorn ...`). Copie para backend/.env (nunca versionar).
# Todos os valores são opcionais; os padrões estão em src/fronteira_fx/config.py. A lista completa e
# comentada (as 31 configurações, inclusive notificações, stream e sondagem) está em ../.env.example,
# seção "Backend (api e worker)": copie de lá o que precisar.
# Comentários só em linhas próprias: parsers de dotenv divergem sobre comentários no fim da linha.

DATABASE_URL=sqlite:///./var/fx.db
# Postgres local (ex.: o do compose): postgresql+psycopg://fx:<senha>@localhost:5432/fx
# Modo de dados desta instância: real | simulation | demo. Os modos nunca se misturam.
DATA_MODE=real
# 1 = semeia linhas de demonstração com o banco vazio (servidas só com DATA_MODE=demo).
FX_SEED_DEMO=0
CORS_ORIGINS=http://localhost:3000
# Quando definida, protege /mcp e as rotas de escrita (X-API-Key ou Bearer). Gere com `openssl rand -hex 32`.
API_KEY=
EVIDENCE_DIR=./var/evidence
POLL_INTERVAL_S=300
EVENT_RETENTION=20000
EVENT_RETENTION_S=86400
STREAM_MAX_DURATION_S=55
# Modo serverless (Vercel + agendador externo); padrões desligados. Ver docs/deploy.md.
FX_SERVERLESS=0
CRON_SECRET=
STREAM_RETRY_MS=1000
COLLECT_BUDGET_S=45

# Supabase como Postgres gerenciado (opcional): placeholders, nunca valores reais. Ver docs/deploy.md.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
# Em produção o esquema vem das migrações (cd backend && uv run alembic upgrade head):
# AUTO_CREATE_SCHEMA=false

# Macro (módulo market). Chaves só por variável de ambiente, nunca no Git. Sem FRED_API_KEY a fonte FRED fica
# desligada. BRAPI_TOKEN serve só a testes da B3 (brapi.dev, 1 ticker por chamada, 15.000 por mês).
FRED_API_KEY=
BRAPI_TOKEN=
