# Copy to .env (never commit). All values optional; defaults in src/fronteira_fx/config.py.
# Read by the backend when it runs outside docker compose (`uv run uvicorn ...`). The full list of
# variables, compose included, lives in ../.env.example. Comments only on their own lines.
DATABASE_URL=sqlite:///./var/fx.db
# DATABASE_URL=postgresql+psycopg://fx:fx@localhost:5432/fx
# real | simulation | demo (the modes never mix)
DATA_MODE=real
# 1 => seed demo rows when the DB is empty (served only when DATA_MODE=demo)
FX_SEED_DEMO=0
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
# When set, protects /mcp and write endpoints (X-API-Key or Bearer)
API_KEY=
POLL_INTERVAL_S=300
EVENT_RETENTION=20000
EVENT_RETENTION_S=86400
STREAM_MAX_DURATION_S=55

# Supabase como Postgres gerenciado (opcional) — placeholders, nunca valores reais. Ver docs/deploy.md.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
# Em produção, migrações com: cd backend && uv run alembic upgrade head
# AUTO_CREATE_SCHEMA=false
