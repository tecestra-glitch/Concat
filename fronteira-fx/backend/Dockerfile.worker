# Fronteira FX — worker coletor (loop de sondagem + Playwright/Chromium para adaptadores de navegador).
# A versão do Playwright tem de ser a MESMA do uv.lock (hoje 1.64.1): a imagem já traz o Chromium
# correspondente e o `playwright install` abaixo vira um no-op. Base pinada por digest; para atualizar:
#   docker buildx imagetools inspect mcr.microsoft.com/playwright/python:v<versão>-noble
FROM mcr.microsoft.com/playwright/python:v1.64.1-noble@sha256:330d401ae23c905896a0c26c66c36fc971b621519e7b11b435a8328d7bf6e031
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_INSTALL_DIR=/opt/uv/python \
    PATH="/opt/venv/bin:$PATH"
# Binário do uv na mesma versão do `uv_build` do pyproject, pinado por digest.
COPY --from=ghcr.io/astral-sh/uv:0.11.32@sha256:df4cae8f3a96d175e2e5f992e597550000edbe78fdc2594d5cd8de1a217f504c /uv /uvx /bin/
WORKDIR /app

# A imagem traz Python 3.12; o projeto exige 3.13 (instalado pelo uv). Dependências primeiro.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv python install 3.13 \
    && uv sync --frozen --no-dev --no-install-project --extra browser
COPY src ./src
COPY alembic ./alembic
COPY alembic.ini ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra browser \
    && playwright install chromium \
    && python -m compileall -q /app/src

# Processo sem root com o MESMO UID/GID da api (10001): ambos montam o volume de evidências em
# /app/var/evidence e o dono do diretório tem de coincidir em qualquer ordem de arranque.
# O Chromium precisa de um HOME gravável (perfil, cache), por isso --create-home.
RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --create-home --home-dir /home/app --shell /usr/sbin/nologin app \
    && mkdir -p /app/var/evidence \
    && chown -R app:app /app/var
USER app

CMD ["python", "-m", "fronteira_fx.services.worker"]
