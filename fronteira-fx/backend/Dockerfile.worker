# Fronteira FX worker: collector loop with Playwright/Chromium for browser adapters
FROM mcr.microsoft.com/playwright/python:v1.54.0-noble
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1 UV_PROJECT_ENVIRONMENT=/opt/venv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv python install 3.13 && uv sync --frozen --no-dev --no-install-project --extra browser
COPY src ./src
COPY alembic ./alembic
COPY alembic.ini ./
RUN uv sync --frozen --no-dev --extra browser && uv run playwright install chromium
RUN mkdir -p /app/var/evidence
CMD ["uv", "run", "python", "-m", "fronteira_fx.services.worker"]
